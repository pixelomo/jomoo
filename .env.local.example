# App URL — used for server-side auth links and emails.
# Local dev: leave unset or use http://localhost:3000 (auth client uses browser origin automatically).
# Production: https://jomoo-ashy.vercel.app
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (Railway or other) — required for sign-in/sign-up (Better Auth)
# DATABASE_URL=postgresql://...

# Better Auth
# BETTER_AUTH_SECRET=

# Optional auth features — both off by default (client wants the simplest
# sign-up). Code for both is retained; set to "true" and redeploy to restore.
#   NEXT_PUBLIC_AUTH_TWO_FACTOR       TOTP at sign-in + dashboard enrolment panel
#   NEXT_PUBLIC_AUTH_EMAIL_VERIFICATION  require a confirmed address before first
#                                     sign-in (this is the spam / typo defence)
# NEXT_PUBLIC_AUTH_TWO_FACTOR=false
# NEXT_PUBLIC_AUTH_EMAIL_VERIFICATION=false
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=sk...

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend
RESEND_API_KEY=re_...
# Local dev: use onboarding@resend.dev (only delivers to verified emails in Resend dashboard)
RESEND_FROM_EMAIL=onboarding@resend.dev
# Fallback for any inquiry category with no department address set below
CONTACT_TO_EMAIL=alan.s@uralaverse.com

# Contact form routing — one address per inquiry category.
# Ids match CONTACT_CATEGORIES in src/types/contact.ts.
# Left blank on purpose for now: everything falls back to CONTACT_TO_EMAIL
# until the client confirms the department addresses.
CONTACT_TO_PRODUCT=
CONTACT_TO_PURCHASE=
CONTACT_TO_SUPPORT=
CONTACT_TO_INSTALLATION=
CONTACT_TO_PARTNERSHIP=
CONTACT_TO_OTHER=
# Local Resend test accounts can only deliver to the verified owner email.
# Set this in .env.local so contact form emails arrive during development:
CONTACT_DEV_TO_EMAIL=sutherland_a@me.com
# In development, contact form logs instead of sending when Resend fails or is unset.
# Set CONTACT_DEV_FALLBACK=false to require a real send locally.

# Serial Number CRM — TBD when client IT provides endpoint
# SERIAL_VALIDATION_ENDPOINT=
# SERIAL_VALIDATION_API_KEY=

# Admin portal
ADMIN_USERNAME=JOMOO
ADMIN_PASSWORD=your_admin_password
